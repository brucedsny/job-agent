# Copy to .env. Never commit .env.
ANTHROPIC_API_KEY=

# Discovery sources (JSON lists), e.g. GREENHOUSE_BOARDS=["stripe","airbnb"]
GREENHOUSE_BOARDS=[]
LEVER_COMPANIES=[]
ASHBY_BOARDS=[]

# ATS submission (optional). Without it, API mode falls back to manual.
GREENHOUSE_API_KEY=

# Per-run LLM spend cap (USD)
SPEND_CAP_USD=5.00

# Email submission (optional). Without SMTP, emails are saved to data/outbox/.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Browser automation (Gate C). Off by default.
GATE_C_ENABLED=false
