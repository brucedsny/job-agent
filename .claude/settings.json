{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(cat:*)",
      "Bash(find:*)",
      "Bash(git add:*)",
      "Bash(git branch:*)",
      "Bash(git checkout:*)",
      "Bash(git commit:*)",
      "Bash(git diff:*)",
      "Bash(git fetch:*)",
      "Bash(git log:*)",
      "Bash(git pull:*)",
      "Bash(git push:*)",
      "Bash(git status:*)",
      "Bash(grep:*)",
      "Bash(ls:*)",
      "Read(//home/user/job-agent/**)",
      "mcp__Gmail__download_gmail_attachment",
      "mcp__Gmail__get_message",
      "mcp__Gmail__get_thread",
      "mcp__Gmail__list_drafts",
      "mcp__Gmail__list_labels",
      "mcp__Gmail__search_threads",
      "mcp__Google_Calendar",
      "mcp__Google_Docs",
      "mcp__Google_Drive"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./secrets/**)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/session-start.sh"
          },
          {
            "type": "command",
            "command": ".claude/hooks/privacy-check.sh",
            "timeout": 15
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/junta-reminder.sh",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
