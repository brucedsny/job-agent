{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(cat:*)",
      "Bash(find:*)",
      "Bash(git add:*)",
      "Bash(git branch:*)",
      "Bash(git checkout:*)",
      "Bash(git commit:*)",
      "Bash(git diff:*)",
      "Bash(git fetch:*)",
      "Bash(git log:*)",
      "Bash(git pull:*)",
      "Bash(git push:*)",
      "Bash(git status:*)",
      "Bash(grep:*)",
      "Bash(ls:*)",
      "Read(//home/user/job-agent/**)",
      "mcp__Gmail__download_gmail_attachment",
      "mcp__Gmail__get_message",
      "mcp__Gmail__get_thread",
      "mcp__Gmail__list_drafts",
      "mcp__Gmail__list_labels",
      "mcp__Gmail__search_threads",
      "mcp__Google_Calendar",
      "mcp__Google_Docs",
      "mcp__Google_Drive",
      "mcp__7ac12b5d-3ff0-4d87-a4e9-4bf8f95c04c2",
      "mcp__da2d0fbe-9f5a-4810-ad02-084fbb3abc1d",
      "mcp__6f696a39-1eef-4676-a72e-523ebf50a897",
      "mcp__42d74fcc-602b-413c-8e79-96c23f7d4030__search_threads",
      "mcp__42d74fcc-602b-413c-8e79-96c23f7d4030__get_thread",
      "mcp__42d74fcc-602b-413c-8e79-96c23f7d4030__get_message",
      "mcp__42d74fcc-602b-413c-8e79-96c23f7d4030__list_labels",
      "mcp__42d74fcc-602b-413c-8e79-96c23f7d4030__list_drafts",
      "mcp__42d74fcc-602b-413c-8e79-96c23f7d4030__download_gmail_attachment"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./secrets/**)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/session-start.sh"
          },
          {
            "type": "command",
            "command": ".claude/hooks/privacy-check.sh",
            "timeout": 15
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/junta-reminder.sh",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
